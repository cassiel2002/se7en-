rules_version = '2';

// Reglas de seguridad de Firestore — Se7en Barbershop v4.0
//
// Principios:
// - El admin puede todo (salvo lo indicado).
// - El cajero solo lee y registra lo propio, y no puede alterar puntos ni
//   totales salvo como consecuencia de una venta o un canje real, que las reglas
//   verifican leyendo el documento creado en el mismo batch/transacción.
// - El rol se toma del token (custom claim `role`, ver tools/README.md) y, si el
//   token todavía no lo tiene, del documento users/{uid}.
service cloud.firestore {
  match /databases/{database}/documents {

    // ============ FUNCIONES AUXILIARES ============

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // Rol: primero el custom claim (no cuesta lecturas); si no está, el perfil.
    function userRole() {
      return request.auth.token.get('role', '') != ''
        ? request.auth.token.role
        : get(userDoc()).data.role;
    }

    function hasRole() {
      return isAuthenticated() &&
             (request.auth.token.get('role', '') != '' || exists(userDoc()));
    }

    function isAdmin() {
      return hasRole() && userRole() == 'admin';
    }

    function isCajeroOrAdmin() {
      return hasRole() && userRole() in ['admin', 'cashier', 'cajero'];
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // El documento existente pertenece al usuario (campo cajeroId).
    function isOwnRecord() {
      return resource.data.cajeroId == request.auth.uid;
    }

    // El documento nuevo queda a nombre del usuario (no de otro cajero).
    function createsOwnRecord() {
      return request.resource.data.cajeroId == request.auth.uid;
    }

    function docPath(coleccion, id) {
      return /databases/$(database)/documents/$(coleccion)/$(id);
    }

    // El documento se crea en esta misma escritura (batch/transacción).
    function seCreaAhora(coleccion, id) {
      return id is string && id != '' &&
             !exists(docPath(coleccion, id)) &&
             existsAfter(docPath(coleccion, id));
    }

    function camposModificados() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ============ USUARIOS ============

    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create, update, delete: if isAdmin();
    }

    // ============ CLIENTES ============

    // Alta por cajero: sin puntos ni visitas iniciales.
    function clienteNuevoValido() {
      let d = request.resource.data;
      return d.get('puntos', 0) == 0 &&
             d.get('puntosCanjeados', 0) == 0 &&
             d.get('visitas', 0) == 0;
    }

    // Edición de datos de contacto.
    function edicionDatosCliente() {
      return camposModificados().hasOnly(['nombre', 'telefono', 'email', 'dni', 'updatedAt']);
    }

    // +1 visita y +1 punto, solo junto con la venta que lo origina.
    function sumaPorVenta(clienteId) {
      let ventaId = request.resource.data.get('ultimaVentaId', '');
      let venta = getAfter(docPath('ventas', ventaId)).data;
      return camposModificados().hasOnly(['visitas', 'puntos', 'ultimaVisita', 'ultimaVentaId', 'updatedAt']) &&
             seCreaAhora('ventas', ventaId) &&
             venta.clienteId == clienteId &&
             venta.cajeroId == request.auth.uid &&
             request.resource.data.puntos == resource.data.get('puntos', 0) + 1 &&
             request.resource.data.visitas == resource.data.get('visitas', 0) + 1;
    }

    // Resta de puntos, solo junto con el canje que la origina y por el valor del premio.
    function restaPorCanje(clienteId) {
      let canjeId = request.resource.data.get('ultimoCanjeId', '');
      let canje = getAfter(docPath('canjes_puntos', canjeId)).data;
      let premio = get(docPath('premios', canje.premioId)).data;
      return camposModificados().hasOnly(['puntos', 'puntosCanjeados', 'ultimoCanjeId', 'updatedAt']) &&
             seCreaAhora('canjes_puntos', canjeId) &&
             canje.clienteId == clienteId &&
             canje.cajeroId == request.auth.uid &&
             premio.activo == true &&
             canje.puntosUtilizados == premio.puntosRequeridos &&
             request.resource.data.puntos == resource.data.get('puntos', 0) - premio.puntosRequeridos &&
             request.resource.data.puntos >= 0 &&
             request.resource.data.puntosCanjeados == resource.data.get('puntosCanjeados', 0) + premio.puntosRequeridos;
    }

    match /clientes/{clienteId} {
      allow read: if isCajeroOrAdmin();
      allow create: if isAdmin() || (isCajeroOrAdmin() && clienteNuevoValido());
      allow update: if isAdmin() ||
                    (isCajeroOrAdmin() &&
                      (edicionDatosCliente() || sumaPorVenta(clienteId) || restaPorCanje(clienteId)));
      allow delete: if isAdmin();
    }

    // ============ SERVICIOS ============

    match /servicios/{servicioId} {
      allow read: if isCajeroOrAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ============ VENTAS ============

    // Venta registrada por un cajero: a su nombre, con la hora del servidor y con
    // el precio vigente del servicio.
    function ventaDeCajeroValida() {
      let v = request.resource.data;
      return createsOwnRecord() &&
             v.createdAt == request.time &&
             v.precio is number &&
             v.precio == get(docPath('servicios', v.servicioId)).data.precio &&
             v.keys().hasOnly(['clienteId', 'clienteNombre', 'servicioId', 'servicioNombre', 'precio',
                               'metodoPago', 'fecha', 'cajeroId', 'cajeroNombre', 'cajeroEmail', 'createdAt']);
    }

    match /ventas/{ventaId} {
      allow read: if isAdmin() || (isCajeroOrAdmin() && isOwnRecord());
      allow create: if isAdmin() ? createsOwnRecord() : (isCajeroOrAdmin() && ventaDeCajeroValida());
      allow update, delete: if isAdmin();
    }

    // ============ RESÚMENES DIARIOS DE VENTAS ============

    // El cajero solo puede sumar su propia venta recién creada al resumen del día.
    function sumaResumenValida() {
      let ventaId = request.resource.data.get('ultimaVentaId', '');
      let venta = getAfter(docPath('ventas', ventaId)).data;
      let antes = resource == null ? { 'total': 0, 'cantidad': 0, 'porCajero': {} } : resource.data;
      let cajeros = request.resource.data.porCajero;
      return request.resource.data.keys().hasOnly(['fecha', 'total', 'cantidad', 'porCajero', 'porServicio', 'ultimaVentaId', 'updatedAt']) &&
             seCreaAhora('ventas', ventaId) &&
             venta.cajeroId == request.auth.uid &&
             request.resource.data.total == antes.total + venta.precio &&
             request.resource.data.cantidad == antes.cantidad + 1 &&
             // Solo cambia la entrada del propio cajero.
             cajeros.diff(antes.porCajero).affectedKeys().hasOnly([request.auth.uid]);
    }

    match /resumenes_ventas/{fecha} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() || (isCajeroOrAdmin() && sumaResumenValida());
      allow delete: if isAdmin();
    }

    // ============ TURNOS / AGENDA ============

    match /turnos/{turnoId} {
      allow read, create, update: if isCajeroOrAdmin();
      allow delete: if isAdmin();
    }

    // ============ PERSONAL ============

    match /plus_manuales/{plusId} {
      allow read: if isCajeroOrAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Adelantos: el admin ve y gestiona todos; el cajero solo los propios.
    match /adelantos/{adelantoId} {
      allow read: if isAdmin() || (isCajeroOrAdmin() && isOwnRecord());
      allow create: if isAdmin() || (isCajeroOrAdmin() && createsOwnRecord());
      allow update, delete: if isAdmin();
    }

    // ============ SISTEMA DE PUNTOS ============

    match /premios/{premioId} {
      allow read: if isCajeroOrAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /canjes_puntos/{canjeId} {
      allow read: if isCajeroOrAdmin();
      allow create: if isCajeroOrAdmin() && createsOwnRecord() &&
                    request.resource.data.estado == 'canjeado';
      allow update, delete: if isAdmin();
    }

    match /movimientos_puntos/{movimientoId} {
      allow read: if isCajeroOrAdmin();
      allow create: if isCajeroOrAdmin() && createsOwnRecord();
      allow update, delete: if isAdmin();
    }

    // ============ CONFIGURACIÓN Y LOGS ============

    match /config/{configId} {
      allow read, write: if isAdmin();
    }

    match /logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ============ RESTO: DENEGADO ============

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
