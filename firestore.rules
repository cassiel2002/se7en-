rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function para verificar si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function para verificar si el usuario es admin
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function para verificar si el usuario es cajero o admin
    function isCajeroOrAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'cashier' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'cajero');
    }

    // USUARIOS - Solo admin puede crear/editar usuarios, usuarios pueden leer su propio perfil
    match /users/{userId} {
      allow read: if isAuthenticated() && (isAdmin() || request.auth.uid == userId);
      allow write: if isAdmin();
    }

    // CLIENTES - Admin y cajeros pueden leer y escribir
    match /clientes/{clienteId} {
      allow read, write: if isCajeroOrAdmin();
    }

    // SERVICIOS - Admin y cajeros pueden leer, solo admin puede escribir
    match /servicios/{servicioId} {
      allow read: if isCajeroOrAdmin();
      allow write: if isAdmin();
    }

    // VENTAS - Admin y cajeros pueden crear y leer ventas
    match /ventas/{ventaId} {
      allow read, create: if isCajeroOrAdmin();
      allow update, delete: if isAdmin();
    }

    // TURNOS - Admin y cajeros pueden gestionar turnos
    match /turnos/{turnoId} {
      allow read, create, update: if isCajeroOrAdmin();
      allow delete: if isAdmin();
    }

    // PLUS MANUALES - Solo admin puede crear/eliminar, todos pueden leer
    match /plus_manuales/{plusId} {
      allow read: if isCajeroOrAdmin();
      allow create, update, delete: if isAdmin();
    }

    // CONFIGURACIÓN DEL SISTEMA - Solo admin
    match /config/{configId} {
      allow read, write: if isAdmin();
    }

    // LOGS/AUDITORÍA - Solo lectura para admin
    match /logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Denegar acceso a cualquier otra colección no especificada
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 