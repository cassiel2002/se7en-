rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============ HELPER FUNCTIONS ============
    
    // Verificar si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Rol del usuario autenticado (1 lectura por petición; Firestore la reutiliza
    // dentro de la misma evaluación).
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasProfile() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Verificar si el usuario es admin
    function isAdmin() {
      return hasProfile() && userRole() == 'admin';
    }
    
    // Verificar si el usuario es cajero o admin
    function isCajeroOrAdmin() {
      return hasProfile() && userRole() in ['admin', 'cashier', 'cajero'];
    }

    // El documento leído pertenece al usuario (campo cajeroId)
    function isOwnRecord() {
      return resource.data.cajeroId == request.auth.uid;
    }

    // El documento que se crea queda a nombre del usuario (no de otro cajero)
    function createsOwnRecord() {
      return request.resource.data.cajeroId == request.auth.uid;
    }

    // Verificar si es el propio usuario
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ============ REGLAS DE ACCESO ============

    // USUARIOS - Solo admin puede crear/editar usuarios, usuarios pueden leer su propio perfil
    match /users/{userId} {
      allow read: if isAuthenticated() && (isAdmin() || isOwner(userId));
      allow create, update, delete: if isAdmin();
    }

    // CLIENTES - Admin y cajeros pueden leer y escribir
    match /clientes/{clienteId} {
      allow read, create, update: if isCajeroOrAdmin();
      allow delete: if isAdmin();
    }

    // SERVICIOS - Admin y cajeros pueden leer, solo admin puede escribir
    match /servicios/{servicioId} {
      allow read: if isCajeroOrAdmin();
      allow create, update, delete: if isAdmin();
    }

    // VENTAS - Admin ve todas; el cajero solo las propias.
    // Todos registran ventas solo a su nombre.
    match /ventas/{ventaId} {
      allow read: if isAdmin() || (isCajeroOrAdmin() && isOwnRecord());
      allow create: if isCajeroOrAdmin() && createsOwnRecord();
      allow update, delete: if isAdmin();
    }

    // TURNOS/AGENDA - Admin y cajeros pueden gestionar turnos
    match /turnos/{turnoId} {
      allow read, create, update: if isCajeroOrAdmin();
      allow delete: if isAdmin();
    }

    // PLUS MANUALES - Solo admin puede crear/eliminar, todos pueden leer
    match /plus_manuales/{plusId} {
      allow read: if isCajeroOrAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ADELANTOS - Admin puede todo, cajeros pueden crear y leer
    match /adelantos/{adelantoId} {
      allow read: if isAdmin() || (isCajeroOrAdmin() && isOwnRecord());
      allow create: if isAdmin() || (isCajeroOrAdmin() && createsOwnRecord());
      allow update, delete: if isAdmin();
    }

    // ============ SISTEMA DE PUNTOS ============

    // PREMIOS - Admin puede gestionar, cajeros pueden leer
    match /premios/{premioId} {
      allow read: if isCajeroOrAdmin();
      allow create, update, delete: if isAdmin();
    }

    // CANJES DE PUNTOS - Admin y cajeros pueden crear y leer
    match /canjes_puntos/{canjeId} {
      allow read: if isCajeroOrAdmin();
      allow create: if isCajeroOrAdmin() && createsOwnRecord();
      allow update, delete: if isAdmin();
    }

    // MOVIMIENTOS DE PUNTOS - Admin y cajeros pueden crear y leer
    match /movimientos_puntos/{movimientoId} {
      allow read: if isCajeroOrAdmin();
      allow create: if isCajeroOrAdmin() && createsOwnRecord();
      allow update, delete: if isAdmin();
    }

    // ============ CONFIGURACIÓN Y LOGS ============

    // CONFIGURACIÓN DEL SISTEMA - Solo admin
    match /config/{configId} {
      allow read, write: if isAdmin();
    }

    // LOGS/AUDITORÍA - Solo lectura para admin
    match /logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated(); // Permitir crear logs para auditoría
      allow update, delete: if false; // Los logs no se modifican
    }

    // ============ REGLA CATCH-ALL ============
    
    // Denegar acceso a cualquier otra colección no especificada
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 