{
  "name": "se7en-barbershop",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "vite build --mode production",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run build:prod",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
